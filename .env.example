# Copy to .env and fill in. .env is gitignored and never committed.

# CoinMarketCap Pro API key (https://pro.coinmarketcap.com)
CMC_API_KEY=

# Where scripts write generated files (charts, logs, exports)
OUTPUT_DIR=output

# Where scripts read local input datasets from
DATA_DIR=data

# GuruFocus API key (https://www.gurufocus.com/api.php) — used by etfs/guru_metrics.py
GURUFOCUS_API_KEY=

# Where etfs/guru_metrics.py writes its exports
GURU_OUTPUT_DIR=output
